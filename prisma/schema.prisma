  hop_doctor                                          hop_doctor           @relation(fields: [DoctorID], references: [DoctorID], onDelete: NoAction, onUpdate: NoAction, map: "hop_appointment_ibfk_2")
  hop_opd                                             hop_opd[]

  @@index([DoctorID], map: "DoctorID")
  @@index([CreatedByUserID], map: "FK_HOP_Appt_CreatedBy")
  @@index([ModifiedByUserID], map: "FK_HOP_Appt_ModifiedBy")
  @@index([UserID], map: "PatientID")
  @@index([SlotID], map: "FK_Appt_Slot")
}


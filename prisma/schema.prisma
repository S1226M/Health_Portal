  Modified                                            DateTime             @default(now()) @db.DateTime(0)
  CreatedByUserID                                     Int
  ModifiedByUserID                                    Int?
  IsDeleted                                           Boolean              @default(false)
  PatientName                                         String               @db.VarChar(100)
  PatientAge                                          Int?
  Address                                             String?              @db.VarChar(255)
  City                                                String?              @db.VarChar(100)
  State                                               String?              @db.VarChar(100)
  Country                                             String?              @db.VarChar(100)
  SlotID                                              Int?
  AppointmentDate                                     DateTime?            @db.DateTime(0)
  IsVideoConsultant                                   Boolean              @default(false)
  hop_timeslot_master                                 hop_timeslot_master? @relation(fields: [SlotID], references: [SlotID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Appt_Slot")
  sec_user_hop_appointment_CreatedByUserIDTosec_user  sec_user             @relation("hop_appointment_CreatedByUserIDTosec_user", fields: [CreatedByUserID], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "FK_HOP_Appt_CreatedBy")
